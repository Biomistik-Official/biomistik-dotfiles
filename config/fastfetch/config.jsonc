{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
    "logo": {
        "type": "kitty",
        "source": "~/.config/fastfetch/images/",
        // "width": 28,
        "height": 18,
        "padding": {
            "top": 2,
            "left": 2,
            "right": 2
        }
    },
    "display": {
        "separator": "  "
    },
    "modules": [
        "break",
        // --- TOP OF THE LABEL BOX (Rounded) ---
        {
            "type": "custom",
            "format": "╭──────────────────────╮",
            "outputColor": "white"
        },
        {
            "type": "title",
            "key": "│    user             │",
            "keyColor": "#d7bafb",
            "format": "{1}" // {1} Native fastfetch user variable
        },
        {
            "type": "title",
            "key": "│    hname            │",
            "keyColor": "#ffb4ab",
            "format": "{2}" // {2} Native fastfetch hostname variable
        },
        {
            "type": "os",
            "key": "│  󰣇  distro           │",
            "keyColor": "#cfc2da"
        },
        {
            "type": "kernel",
            "key": "│    kernel           │",
            "keyColor": "#f2b7c1"
        },
        {
            "type": "uptime",
            "key": "│  󱎫  uptime           │",
            "keyColor": "#d7bafb"
        },
        {
            "type": "shell",
            "key": "│    shell            │",
            "keyColor": "#ffb4ab"
        },
        {
            "type": "packages",
            "key": "│  󰏖  pkgs             │",
            "keyColor": "#f2b7c1"
        },
        {
            "type": "memory",
            "key": "│  󰍛  memory           │",
            "keyColor": "#cfc2da"
        },
        // --- MIDDLE SEPARATOR ---
        {
            "type": "custom",
            "format": "├──────────────────────┤",
            "outputColor": "white"
        },
        {
            "type": "colors",
            "key": "│  󰏘  colors           │",
            "keyColor": "#d7bafb",
            "symbol": "circle"
        },
        // --- BOTTOM OF THE LABEL BOX (Rounded) ---
        {
            "type": "custom",
            "format": "╰──────────────────────╯",
            "outputColor": "white"
        },
        "break"
    ]
}