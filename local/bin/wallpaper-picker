#!/usr/bin/env bash

WALLDIR="$HOME/Pictures/Wallpapers"

if [ "$ROFI_RETV" = "1" ]; then
    WALL="$ROFI_INFO"

    [ -f "$WALL" ] || exit 0

    awww img "$WALL"
    matugen image --source-color-index 0 "$WALL"
    hyprctl reload
    pkill -USR2 waybar
    exit 0
fi

printf '\0prompt\x1fОбои\n'
printf '\0no-custom\x1ftrue\n'

find "$WALLDIR" -maxdepth 1 -type f \( \
    -iname '*.jpg' -o \
    -iname '*.jpeg' -o \
    -iname '*.png' -o \
    -iname '*.webp' \
\) -print0 |
while IFS= read -r -d '' file; do
    name="$(basename "$file")"
    printf '%s\0icon\x1f%s\x1finfo\x1f%s\n' "$name" "$file" "$file"
done
