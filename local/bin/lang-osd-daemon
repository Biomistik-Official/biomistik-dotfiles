#!/usr/bin/env python3

from ctypes import CDLL
CDLL("libgtk4-layer-shell.so")

import gi
gi.require_version("Gtk", "4.0")
gi.require_version("Gtk4LayerShell", "1.0")

from gi.repository import Gtk, Gdk, GLib
from gi.repository import Gtk4LayerShell as LayerShell

import os
import socket
import threading
import time


class LangOSD:
    def __init__(self, app):
        self.app = app

        self.window = Gtk.Window(application=app)
        self.window.set_decorated(False)
        self.window.set_resizable(False)
        self.window.set_opacity(0.0)

        LayerShell.init_for_window(self.window)
        LayerShell.set_layer(self.window, LayerShell.Layer.OVERLAY)
        LayerShell.set_anchor(self.window, LayerShell.Edge.RIGHT, True)
        LayerShell.set_anchor(self.window, LayerShell.Edge.BOTTOM, True)
        LayerShell.set_margin(self.window, LayerShell.Edge.RIGHT, 28)
        LayerShell.set_margin(self.window, LayerShell.Edge.BOTTOM, 28)
        LayerShell.set_keyboard_mode(
            self.window,
            LayerShell.KeyboardMode.NONE
        )

        try:
            LayerShell.set_namespace(self.window, "lang-osd")
        except Exception:
            pass

        box = Gtk.Box(
            orientation=Gtk.Orientation.HORIZONTAL,
            spacing=12
        )
        box.add_css_class("lang-pill")

        self.code = Gtk.Label(label="EN")
        self.code.add_css_class("lang-code")

        self.name = Gtk.Label(label="English")
        self.name.add_css_class("lang-name")

        box.append(self.code)
        box.append(self.name)

        self.window.set_child(box)

        css = b"""
        window {
            background: transparent;
        }

        .lang-pill {
            background-color: rgba(18, 18, 24, 0.94);
            border: 1px solid rgba(255, 255, 255, 0.11);
            border-radius: 18px;
            padding: 11px 16px;
            box-shadow: 0 6px 24px rgba(0, 0, 0, 0.30);
        }

        .lang-code {
            color: #ff9eae;
            font-family: "Inter", "Noto Sans", sans-serif;
            font-size: 19px;
            font-weight: 800;
        }

        .lang-name {
            color: rgba(255, 255, 255, 0.88);
            font-family: "Inter", "Noto Sans", sans-serif;
            font-size: 14px;
            font-weight: 600;
        }
        """

        provider = Gtk.CssProvider()
        provider.load_from_data(css)

        Gtk.StyleContext.add_provider_for_display(
            Gdk.Display.get_default(),
            provider,
            Gtk.STYLE_PROVIDER_PRIORITY_APPLICATION
        )

        self.generation = 0

        threading.Thread(
            target=self.hyprland_listener,
            daemon=True
        ).start()

    def layout_info(self, raw):
        low = raw.lower()

        if "russian" in low or low.strip() == "ru":
            return "RU", "Русский"

        if (
            "english" in low
            or "british" in low
            or low.strip() in ("gb", "us", "en")
        ):
            return "EN", "English"

        clean = raw.strip()

        if not clean:
            return "??", "Unknown"

        return clean[:2].upper(), clean

    def show_layout(self, raw):
        code, name = self.layout_info(raw)

        self.code.set_text(code)
        self.name.set_text(name)

        self.generation += 1
        generation = self.generation

        self.window.set_opacity(0.0)

        LayerShell.set_margin(
            self.window,
            LayerShell.Edge.RIGHT,
            12
        )

        self.window.present()

        start = time.monotonic()

        def fade_in():
            if generation != self.generation:
                return False

            t = (time.monotonic() - start) / 0.14
            t = min(max(t, 0.0), 1.0)

            eased = 1.0 - (1.0 - t) ** 3

            self.window.set_opacity(eased)

            margin = int(12 + 16 * eased)
            LayerShell.set_margin(
                self.window,
                LayerShell.Edge.RIGHT,
                margin
            )

            return t < 1.0

        GLib.timeout_add(16, fade_in)

        def begin_fade_out():
            if generation != self.generation:
                return False

            out_start = time.monotonic()

            def fade_out():
                if generation != self.generation:
                    return False

                t = (time.monotonic() - out_start) / 0.18
                t = min(max(t, 0.0), 1.0)

                eased = t * t

                self.window.set_opacity(1.0 - eased)

                margin = int(28 - 8 * eased)
                LayerShell.set_margin(
                    self.window,
                    LayerShell.Edge.RIGHT,
                    margin
                )

                if t >= 1.0:
                    self.window.set_visible(False)
                    return False

                return True

            GLib.timeout_add(16, fade_out)
            return False

        GLib.timeout_add(800, begin_fade_out)

        return False

    def hyprland_listener(self):
        runtime = os.environ.get("XDG_RUNTIME_DIR")
        signature = os.environ.get("HYPRLAND_INSTANCE_SIGNATURE")

        if not runtime or not signature:
            return

        path = os.path.join(
            runtime,
            "hypr",
            signature,
            ".socket2.sock"
        )

        while True:
            try:
                sock = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
                sock.connect(path)

                buffer = ""

                while True:
                    data = sock.recv(4096)

                    if not data:
                        break

                    buffer += data.decode(errors="replace")

                    while "\n" in buffer:
                        line, buffer = buffer.split("\n", 1)

                        if line.startswith("activelayout>>"):
                            payload = line[len("activelayout>>"):]

                            if "," in payload:
                                _, layout = payload.split(",", 1)
                                GLib.idle_add(
                                    self.show_layout,
                                    layout.strip()
                                )

                sock.close()

            except Exception:
                pass

            time.sleep(1)


def activate(app):
    app.hold()
    app.osd = LangOSD(app)


app = Gtk.Application(
    application_id="io.biomistik.langosd"
)

app.connect("activate", activate)
app.run(None)
